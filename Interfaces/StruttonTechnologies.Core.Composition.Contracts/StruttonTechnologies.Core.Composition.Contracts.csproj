<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package identity -->
    <PackageId>StruttonTechnologies.Core.Composition.Contracts</PackageId>
    <Title>Composition Contracts for StruttonTechnologies.Core</Title>
    <Description>Composition abstractions and registration contracts for wiring Strutton Technologies core capabilities without depending on concrete implementations.</Description>
    <PackageTags>core;strutton;struttontechnologies;composition;contracts;abstractions;dependency-injection</PackageTags>

    <!-- Versioning -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
